{
  "expo": {
    "name": "Kahve",
    "slug": "kahve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kahve",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#4A1B0C"
    },
    "android": {
      "package": "com.jacarandalab.kahve",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A1B0C"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.jacarandalab.kahve",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kahve usa tus fotos para ilustrar los productos de tu menú."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "SE_LLENA_SOLO_CON_EAS_INIT"
      }
    }
  }
}
