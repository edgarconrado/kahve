{
  "expo": {
    "name": "Kahve",
    "slug": "kahve",
    "version": "1.0.7",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kahve",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#4A1B0C"
    },
    "android": {
      "package": "com.jacarandalab.kahve",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A1B0C"
      },
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jacarandalab.kahve",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kahve usa tus fotos para ilustrar los productos de tu menú."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8d185c21-277e-4f9b-976b-fd44c988a9b0"
      }
    }
  }
}