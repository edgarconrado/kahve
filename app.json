{
  "expo": {
    "name": "Kahve",
    "slug": "kahve",
    "version": "2.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "kahve",
    "android": {
      "package": "com.jacarandalab.kahve",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A1B0C"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jacarandalab.kahve",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kahve usa tus fotos para ilustrar los productos de tu menú."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4A1B0C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4A1B0C"
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-sharing",
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "8d185c21-277e-4f9b-976b-fd44c988a9b0"
      }
    }
  }
}
